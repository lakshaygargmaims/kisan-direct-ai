# ── KisanDirect AI backend — environment template ────────────────
# LOCAL DEV (zero-setup, default):
#   DATABASE_URL="file:./prisma/dev.db"   → SQLite, no server needed
#   Prisma reads backend/.env — the dev schema (schema.prisma) is SQLite.
#
# PRODUCTION (Railway): set these as Railway service variables.
#   DATABASE_URL = Railway PostgreSQL plugin → "Internal Connection URL"
#   Prisma derives schema.prod.prisma (PostgreSQL) during the Docker build —
#   you never need to create it by hand.
# ─────────────────────────────────────────────────────────────────

# Database — SQLite for local dev / set Postgres URL on Railway
DATABASE_URL="file:./prisma/dev.db"

# Server
PORT=3001
NODE_ENV="development"
# Only needed when the UI origin differs from the API origin (dev: Vite :5173)
FRONTEND_URL="http://localhost:5173"

# Auth
JWT_SECRET="kisan-direct-dev-secret-key-change-in-production"
JWT_EXPIRES_IN="7d"

# Optional extra CORS origins (comma separated)
# CORS_ORIGINS="https://app.example.com"

# Demo-mode providers — all default to DEMO (no keys needed)
MAP_PROVIDER="demo"
PAYMENT_PROVIDER="demo"
LOGISTICS_PROVIDER="demo"
STORAGE_PROVIDER="local"
EMAIL_PROVIDER="demo"
SMS_PROVIDER="demo"

# Placeholders for future live providers (leave empty in demo mode)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
PORTER_API_KEY=""
GEOCODING_API_KEY=""
ROUTING_API_KEY=""
