# ─────────────────────────────────────────────────────────────────
# KisanDirect AI — Backend Environment Variables
# ─────────────────────────────────────────────────────────────────

# DATABASE — PostgreSQL (Supabase / Neon / Railway)
# For local dev with SQLite, use: DATABASE_URL="file:./prisma/dev.db"
# For production with PostgreSQL, use the connection string from Supabase
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT].supabase.co:5432/postgres"

# SERVER
PORT=3001
NODE_ENV="development"

# CORS — Frontend URL (update for production)
FRONTEND_URL="http://localhost:5173"

# AUTH
JWT_SECRET="kisan-direct-dev-secret-change-in-production"
JWT_EXPIRES_IN="7d"

# OPTIONAL — Extra CORS origins (comma separated)
# CORS_ORIGINS="https://app.vercel.app,https://kisandirect.vercel.app"

# DEMO MODE — All providers default to demo (no keys needed)
MAP_PROVIDER="demo"
PAYMENT_PROVIDER="demo"
LOGISTICS_PROVIDER="demo"
STORAGE_PROVIDER="local"
EMAIL_PROVIDER="demo"
SMS_PROVIDER="demo"

# FUTURE — Live provider keys (leave empty in demo mode)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
PORTER_API_KEY=""
GEOCODING_API_KEY=""
ROUTING_API_KEY=""
