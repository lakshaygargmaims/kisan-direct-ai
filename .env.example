# ── KisanDirect AI — production environment template ─────────────
# Copy to .env only for LOCAL use. Railway provides these as service
# variables — do not commit real secrets.

# ── Database ────────────────────────────────────────────────────
# Railway: use the "Internal Connection URL" from your Railway PostgreSQL
#          plugin, e.g.  postgresql://user:password@host:5432/railway
# Local:   PostgreSQL or keep the SQLite default below for zero-setup dev
DATABASE_URL="file:./backend/prisma/dev.db"

# ── Server ──────────────────────────────────────────────────────
# Railway injects PORT automatically; leave unset locally (backend uses 3001)
# PORT=3001
NODE_ENV="development"
# Only needed if the UI is served from a different origin than the API
# FRONTEND_URL="http://localhost:5173"

# ── Auth ────────────────────────────────────────────────────────
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# ── Optional: extra CORS origins (comma-separated) ──────────────
# CORS_ORIGINS="https://app.example.com,https://admin.example.com"

# ── Demo-mode providers (default — no paid keys required) ───────
MAP_PROVIDER="demo"
PAYMENT_PROVIDER="demo"
LOGISTICS_PROVIDER="demo"
STORAGE_PROVIDER="local"
EMAIL_PROVIDER="demo"
SMS_PROVIDER="demo"
