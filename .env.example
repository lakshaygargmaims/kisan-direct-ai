# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kisandirect?schema=public"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# Server
PORT=3001
NODE_ENV=development
FRONTEND_URL="http://localhost:5173"

# AI Service
AI_SERVICE_URL="http://localhost:8000"

# Map Provider (Demo mode uses mock data)
MAP_PROVIDER="demo"
MAP_PROVIDER_KEY=""
GEOCODING_API_KEY=""
ROUTING_API_KEY=""

# Payment (Demo mode simulates payments)
PAYMENT_PROVIDER="demo"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Logistics (Demo mode simulates delivery)
LOGISTICS_PROVIDER="demo"
PORTER_API_KEY=""

# Storage (Demo mode uses local filesystem)
STORAGE_PROVIDER="local"
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
AWS_S3_BUCKET=""
AWS_S3_REGION=""

# Email (Demo mode logs to console)
EMAIL_PROVIDER="demo"
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""

# SMS (Demo mode logs to console)
SMS_PROVIDER="demo"
